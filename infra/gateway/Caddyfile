{
    auto_https disable_redirects
    skip_install_trust
}

https://localhost:8443 {
    tls internal

    route {
        @accountsDocs path /api/docs/accounts/openapi.json
        handle @accountsDocs {
            rewrite * /api/docs/openapi.json
            reverse_proxy api:3000
        }

        @automationDocs path /api/docs/automation/openapi.json
        handle @automationDocs {
            rewrite * /api/docs/openapi.json
            reverse_proxy automation:3000
        }

        @monitoringDocs path /api/docs/monitoring/openapi.json
        handle @monitoringDocs {
            rewrite * /api/docs/openapi.json
            reverse_proxy monitoring:3000
        }

        @sportDocs path /api/docs/sport/openapi.json
        handle @sportDocs {
            rewrite * /api/docs/openapi.json
            reverse_proxy sport:3000
        }

        @sportApi path /sport/api/v1/activities/export /sport/api/v1/gym-sessions /sport/api/v1/gym-sessions/*
        handle @sportApi {
            uri strip_prefix /sport
            reverse_proxy sport:3000
        }

        @sportPrivate path /sport /sport/*
        handle @sportPrivate {
            respond "Not found" 404
        }

        @academicDocs path /api/docs/academic/openapi.json
        handle @academicDocs {
            rewrite * /api/docs/openapi.json
            reverse_proxy academic:3000
        }

        @academicApi path /academic/api/v1/assignments /academic/api/v1/assignments/* /academic/api/v1/exams /academic/api/v1/exams/*
        handle @academicApi {
            uri strip_prefix /academic
            reverse_proxy academic:3000
        }

        @academicPrivate path /academic /academic/*
        handle @academicPrivate {
            respond "Not found" 404
        }

        @auth path /api/v1/auth /api/v1/auth/*
        handle @auth {
            reverse_proxy api:3000
        }

        @monitoring path /api/v1/monitoring /api/v1/monitoring/* /api/v1/notifications /api/v1/notifications/*
        handle @monitoring {
            reverse_proxy monitoring:3000
        }

        @automation path /api/v1/automation /api/v1/automation/*
        handle @automation {
            reverse_proxy automation:3000
        }

        @api path /api /api/*
        handle @api {
            reverse_proxy sync:3000
        }

        @internal path /internal /internal/*
        handle @internal {
            respond "Not found" 404
        }

        handle {
            reverse_proxy web:8080
        }
    }
}
