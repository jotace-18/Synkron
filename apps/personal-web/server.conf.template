map $host $personal_host_allowed {
    default 0;
    localhost 1;
    127.0.0.1 1;
}

map $http_origin $personal_origin {
    default forbidden;
    "" absent;
    "http://127.0.0.1:3107" allowed;
    "http://localhost:3107" allowed;
}

map "$request_method:$personal_origin" $personal_api_allowed {
    default 0;
    "GET:absent" 1;
    "GET:allowed" 1;
    "HEAD:absent" 1;
    "HEAD:allowed" 1;
    "POST:allowed" 1;
    "PATCH:allowed" 1;
    "DELETE:allowed" 1;
}

server {
    listen 8080;
    server_name localhost 127.0.0.1;

    root /usr/share/nginx/html;
    index index.html;

    if ($personal_host_allowed = 0) {
        return 403;
    }

    location = /healthz {
        access_log off;
        default_type application/json;
        return 200 '{"status":"ok","service":"personal-web"}';
    }

    location ~ ^/api/v1/events(?:/|$) {
        if ($personal_api_allowed = 0) {
            return 403;
        }

        resolver 127.0.0.11 valid=10s ipv6=off;
        set $personal_backend personal:3000;

        proxy_pass http://$personal_backend$request_uri;
        proxy_http_version 1.1;

        proxy_set_header Host $personal_backend;
        proxy_set_header Authorization "Bearer ${PERSONAL_DEMO_TOKEN}";
        proxy_set_header Cookie "";
        proxy_set_header Connection "";

        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
        proxy_redirect off;
    }

    location /api/ {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}