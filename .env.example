# Configuración prevista para cuentas y sesiones (ADR-005).
# No contiene credenciales ni sustituye la configuración de despliegue.
APP_ORIGIN=https://localhost:8443
AUTH_DATABASE_SCHEMA=auth
SESSION_COOKIE_NAME=__Host-synkron_session
SESSION_IDLE_TTL_MINUTES=30
SESSION_ABSOLUTE_TTL_HOURS=12
AUTH_LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=5
AUTH_LOGIN_MAX_ATTEMPTS_PER_IP=30
AUTH_LOGIN_WINDOW_MINUTES=15

# PostgreSQL de Sync: configuración inicial
SYNC_DB_NAME=synkron_sync
SYNC_DB_ADMIN_USER=sync_admin
SYNC_DB_ADMIN_PASSWORD=replace-me-locally
SYNC_DB_USER=sync_app
SYNC_DB_PASSWORD=replace-me-locally
